rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Personnel BIGBLU (espace admin) ----
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().data.actif == true;
    }
    function isAdmin() { return isStaff() && staffDoc().data.role == 'admin'; }

    match /staff/{uid} {
      allow read: if isStaff();
      allow write: if isAdmin();
      // Première configuration : le tout premier compte admin se crée lui-même depuis /admin,
      // une seule fois. Ensuite le verrou config/setup existe et cette porte est fermée.
      allow create: if request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/config/setup)
        && existsAfter(/databases/$(database)/documents/config/setup)
        && request.resource.data.role == 'admin' && request.resource.data.actif == true;
      // Invitation : la personne invitée (même adresse Google, vérifiée) active son propre accès.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower()))
        && request.resource.data.keys().hasOnly(['nom','email','role','actif','createdAt'])
        && request.resource.data.role == get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.role
        && request.resource.data.actif == true;
    }

    // ---- Invitations du personnel (connexion Google) ----
    match /invitations/{email} {
      allow read: if isStaff()
        || (request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() == email);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['nom','email','role','createdAt','by'])
        && request.resource.data.role in ['admin', 'service_client']
        && request.resource.data.email == email;
      allow delete: if isAdmin() || (request.auth != null && request.auth.token.email.lower() == email);
    }

    match /config/setup {
      allow get: if true;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/config/setup)
        && request.resource.data.keys().hasOnly(['done','by','at'])
        && request.resource.data.by == request.auth.uid
        && getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Inscriptions voyage (Albanie) ----
    // Public : peut seulement ENVOYER une inscription (aucune lecture possible).
    match /inscriptions_voyage/{id} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly([
            'programme','nom','prenoms','dateNaissance','sexe','nationalite','ville','telephone','email',
            'passeport','metier','poste','licencePro','clubActuel','joursAppel','creneau','bureau','bureauDate',
            'message','offre','parcours','pretPayer','quandPret','lien','source','statut','createdAt'])
        && request.resource.data.programme in ['travail', 'football']
        && request.resource.data.offre in ['', 'usine', 'hotel']
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 300
        && request.resource.data.telephone is string && request.resource.data.telephone.size() >= 8 && request.resource.data.telephone.size() <= 300
        && request.resource.data.joursAppel is list && request.resource.data.joursAppel.size() <= 7
        && request.resource.data.parcours in ['complet', 'plus_tard', 'non']
        && request.resource.data.statut in ['nouveau', 'plus_tard', 'pas_interesse']
        && request.resource.data.createdAt == request.time;
      // Service client et admin : lecture + suivi (statut, notes, RDV).
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['statut','notes','historique','rdvDate','updatedAt','updatedBy']);
      // Suppression : admin général uniquement.
      allow delete: if isAdmin();
    }

    // ---- Statistiques anonymes du parcours (étapes atteintes) ----
    match /visites/{id} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['programme','etape','sid','source','createdAt'])
        && request.resource.data.programme in ['travail', 'football']
        && request.resource.data.etape in ['avantages','procedure','documents','formulaire','choix_plus_tard','choix_non']
        && request.resource.data.sid is string && request.resource.data.sid.size() <= 20
        && request.resource.data.source is string && request.resource.data.source.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow read: if isStaff();
      allow delete: if isAdmin();
    }

    // ---- Messages (contact + projets) ----
    match /messages/{id} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['type','nom','entreprise','email','telephone','objet','message','lu','createdAt'])
        && request.resource.data.type in ['contact', 'projet']
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.lu == false
        && request.resource.data.createdAt == request.time;
      allow read: if isStaff();
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lu']);
      allow delete: if isAdmin();
    }

    // Tout le reste est fermé.
    match /{document=**} { allow read, write: if false; }
  }
}

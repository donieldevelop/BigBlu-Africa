rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Inscriptions VISION@FRICA : le public peut seulement ENVOYER une inscription.
    match /inscriptions_voyage/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'programme','nom','prenoms','dateNaissance','sexe','nationalite','telephone',
            'email','ville','passeport','metier','poste','clubActuel','licencePro',
            'disponibilite','message','statut','source','createdAt'])
        && request.resource.data.programme in ['travail', 'football']
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 300
        && request.resource.data.telephone is string && request.resource.data.telephone.size() >= 8 && request.resource.data.telephone.size() <= 300
        && request.resource.data.statut == 'nouveau'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
